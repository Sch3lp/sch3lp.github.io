---
import { site } from '../site';

interface Props {
  // Must stay equal to what Jekyll used (the post's filename) to keep existing threads.
  identifier: string;
  url: string;
}

const { identifier, url } = Astro.props;
const shortname = site.disqusShortname;
---

{
  shortname && (
    <section class="comments" data-shortname={shortname} data-identifier={identifier} data-url={url}>
      <button type="button" class="load-comments">Show comments</button>
      <div id="disqus_thread" />
    </section>
  )
}

<script>
  // Disqus is only loaded when the reader asks for it: no third-party tracking by default.
  const section = document.querySelector<HTMLElement>('.comments');
  section?.querySelector('button')?.addEventListener('click', (e) => {
    (e.currentTarget as HTMLElement).remove();
    const { shortname, identifier, url } = section.dataset;
    (window as any).disqus_config = function (this: any) {
      this.page.identifier = identifier;
      this.page.url = url;
    };
    const s = document.createElement('script');
    s.src = `https://${shortname}.disqus.com/embed.js`;
    s.setAttribute('data-timestamp', String(Date.now()));
    document.body.appendChild(s);
  });
</script>

<style>
  .comments {
    margin-top: 3rem;
  }

  .load-comments {
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 0.55em 1.2em;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: none;
    color: var(--accent);
    cursor: pointer;
  }

  .load-comments:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
