---
import { site } from '../site';

const { repo, repoId, category, categoryId } = site.giscus;
---

{
  categoryId && (
    <section class="comments">
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    </section>
  )
}

<script>
  // Keep giscus in sync with the site's theme toggle.
  function giscusTheme() {
    const theme = document.documentElement.dataset.theme;
    return theme === 'dark' ? 'dark_dimmed' : theme === 'light' ? 'light' : 'preferred_color_scheme';
  }

  function sendTheme() {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: giscusTheme() } } }, 'https://giscus.app');
  }

  new MutationObserver(sendTheme).observe(document.documentElement, { attributeFilter: ['data-theme'] });
  window.addEventListener('message', (e) => {
    if (e.origin === 'https://giscus.app') sendTheme();
  });
</script>

<style>
  .comments {
    margin-top: 3rem;
  }
</style>
