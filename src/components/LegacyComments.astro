---
// Comments from the old Disqus-powered blog, generated by scripts/import-disqus.mjs.
import legacyComments from '../data/legacy-comments.json';
import { formatDate } from '../posts';

interface Props {
  postId: string;
}

type Comment = { author: string; date: string; html: string };

const comments: Comment[] = (legacyComments as Record<string, Comment[]>)[Astro.props.postId] ?? [];
---

{
  comments.length > 0 && (
    <section class="legacy-comments">
      <h2>Comments from the old blog</h2>
      <ol>
        {comments.map((c) => (
          <li>
            <p class="meta">
              <strong>{c.author}</strong> · <time datetime={c.date}>{formatDate(new Date(c.date))}</time>
            </p>
            <div class="body" set:html={c.html} />
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .legacy-comments {
    margin-top: 3.5rem;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }

  .meta {
    margin: 0 0 0.35rem;
  }

  .meta strong {
    color: var(--text);
    font-weight: 600;
  }

  .body {
    font-size: 1rem;
  }

  .body :global(p) {
    margin: 0 0 0.75em;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
