---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../posts';
import { site } from '../site';

const posts = await getPosts();
---

<Base>
  <section class="intro">
    <h1>{site.tagline}</h1>
    <p class="bio">
      <span>💻 Software Crafter</span>
      <span>🌱 Coach</span>
      <span>☀️ People person</span>
    </p>
  </section>
  <PostList posts={posts} />
</Base>

<style>
  .intro {
    margin: 1.5rem 0 3.5rem;
  }

  .intro h1 {
    margin: 0 0 0.5rem;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
  }

  .bio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-family: var(--font-sans);
  }
</style>
